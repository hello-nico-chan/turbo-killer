    },
    "Automatically open TurboKiller when you log in to your Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macへのログイン時にTurboKillerを自動的に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 로그인할 때 TurboKiller를 자동으로 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Mac 时自动打开 TurboKiller。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 Mac 時自動開啟 TurboKiller。"
          }
        }
      }
    },
    "Background helper approval required": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
