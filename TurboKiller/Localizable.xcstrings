{
  "sourceLanguage": "en",
  "strings": {
    "Apple silicon detected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleシリコンMacを検出しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple silicon Mac이 감지되었습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到 Apple 芯片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已偵測到 Apple 晶片"
          }
        }
      }
    },
    "Approval required": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인이 필요합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要批准"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要核准"
          }
        }
      }
    },
    "Background helper approval required": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドHelperの承認が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 Helper 승인이 필요합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要批准后台 Helper"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要核准背景 Helper"
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新檢查"
          }
        }
      }
    },
    "Could not connect to the TurboKiller privileged helper.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 TurboKiller 特权 Helper。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 TurboKiller 特權 Helper。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller の特権 Helper に接続できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 권한 Helper에 연결할 수 없습니다."
          }
        }
      }
    },
    "Could not unregister the previous privileged helper:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法注销之前的特权 Helper："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取消註冊先前的特權 Helper："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の特権 Helper の登録を解除できませんでした："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 권한 Helper의 등록을 해제할 수 없습니다:"
          }
        }
      }
    },
    "Hardware control is not connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件控制尚未连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "硬體控制尚未連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェア制御に接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하드웨어 제어가 연결되어 있지 않습니다."
          }
        }
      }
    },
    "Intel Mac detected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Intel Macを検出しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Intel Mac이 감지되었습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到 Intel Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已偵測到 Intel Mac"
          }
        }
      }
    },
    "Kill Turbo Boost": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo Boostを無効にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo Boost 끄기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 Turbo Boost"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 Turbo Boost"
          }
        }
      }
    },
    "macOS blocked the Turbo Boost kernel extension. Open System Settings → Privacy & Security and allow it, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已阻止 Turbo Boost 内核扩展。请打开“系统设置 → 隐私与安全性”并允许该扩展，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已阻擋 Turbo Boost 核心延伸模組。請開啟「系統設定 → 隱私權與安全性」並允許該延伸模組，然後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が Turbo Boost カーネル拡張をブロックしました。「システム設定 → プライバシーとセキュリティ」で許可してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 Turbo Boost 커널 확장을 차단했습니다. “시스템 설정 → 개인정보 보호 및 보안”에서 허용한 후 다시 시도하세요."
          }
        }
      }
    },
    "macOS has approved the kernel extension, but your Mac must be restarted once before TurboKiller can use it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已批准内核扩展，但必须重新启动一次 Mac，TurboKiller 才能使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已允許核心延伸模組，但必須重新啟動一次 Mac，TurboKiller 才能使用它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS でカーネル拡張は承認されましたが、TurboKiller で使用するには Mac を一度再起動する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 커널 확장을 승인했지만 TurboKiller에서 사용하려면 Mac을 한 번 재시동해야 합니다."
          }
        }
      }
    },
    "Maximum CPU performance is available.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUの最大パフォーマンスを利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU의 최대 성능을 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 可发挥最高性能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 可發揮最高效能。"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 열기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟系統設定"
          }
        }
      }
    },
    "Quit TurboKiller": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKillerを終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 종료"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 TurboKiller"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 TurboKiller"
          }
        }
      }
    },
    "Restart required": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시동이 필요합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啟動"
          }
        }
      }
    },
    "Restore Turbo Boost": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo Boostを復元"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo Boost 복원"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复 Turbo Boost"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復 Turbo Boost"
          }
        }
      }
    },
    "The bundled Turbo Boost kernel extension could not be found.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到内置的 Turbo Boost 内核扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到內建的 Turbo Boost 核心延伸模組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱されている Turbo Boost カーネル拡張が見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장된 Turbo Boost 커널 확장을 찾을 수 없습니다."
          }
        }
      }
    },
    "The bundled Turbo Boost kernel extension does not match the expected version.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置的 Turbo Boost 内核扩展与预期版本不匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建的 Turbo Boost 核心延伸模組與預期版本不符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱されている Turbo Boost カーネル拡張が想定されたバージョンと一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장된 Turbo Boost 커널 확장이 예상된 버전과 일치하지 않습니다."
          }
        }
      }
    },
    "The CPU is running without Turbo Boost.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUはTurbo Boostなしで動作しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU가 Turbo Boost 없이 실행 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 当前未启用 Turbo Boost。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 目前未啟用 Turbo Boost。"
          }
        }
      }
    },
    "The kernel extension could not be loaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载内核扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入核心延伸模組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーネル拡張をロードできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널 확장을 로드할 수 없습니다."
          }
        }
      }
    },
    "The kernel extension could not be unloaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法卸载内核扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法卸載核心延伸模組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーネル拡張をアンロードできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널 확장을 언로드할 수 없습니다."
          }
        }
      }
    },
    "The kernel extension must be approved in System Settings before it can be used.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前必须先在系统设置中批准该内核扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前必須先在系統設定中允許該核心延伸模組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用する前に、システム設定でカーネル拡張を承認する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하기 전에 시스템 설정에서 커널 확장을 승인해야 합니다."
          }
        }
      }
    },
    "The kernel extension was approved, but macOS requires a restart before it can be used.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核扩展已获批准，但 macOS 要求重新启动后才能使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心延伸模組已獲允許，但 macOS 要求重新啟動後才能使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーネル拡張は承認されましたが、使用するには macOS の再起動が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널 확장이 승인되었지만 사용하려면 macOS를 재시동해야 합니다."
          }
        }
      }
    },
    "The TurboKiller privileged helper could not be found.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 TurboKiller 特权 Helper。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 TurboKiller 特權 Helper。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller の特権 Helper が見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 권한 Helper를 찾을 수 없습니다."
          }
        }
      }
    },
    "The TurboKiller privileged helper could not be registered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法注册 TurboKiller 特权 Helper。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法註冊 TurboKiller 特權 Helper。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller の特権 Helper を登録できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 권한 Helper를 등록할 수 없습니다."
          }
        }
      }
    },
    "The TurboKiller privileged helper did not respond.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 特权 Helper 未响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 特權 Helper 沒有回應。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller の特権 Helper が応答しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 권한 Helper가 응답하지 않았습니다."
          }
        }
      }
    },
    "The TurboKiller privileged helper is unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 特权 Helper 当前不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 特權 Helper 目前無法使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller の特権 Helper は現在利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 권한 Helper를 현재 사용할 수 없습니다."
          }
        }
      }
    },
    "This Mac is compatible with TurboKiller's target platform.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはTurboKillerの対象環境に対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 TurboKiller의 대상 환경과 호환됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 符合 TurboKiller 的运行要求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 符合 TurboKiller 的執行需求。"
          }
        }
      }
    },
    "Turbo Boost control failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo Boost 控制失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo Boost 控制失敗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo Boost の制御に失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo Boost 제어에 실패했습니다."
          }
        }
      }
    },
    "Turbo Boost control for Intel Macs": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Intel Mac向けTurbo Boostコントロール"
          }
